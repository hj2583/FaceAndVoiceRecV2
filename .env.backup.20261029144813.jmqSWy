DATABASE_URL=postgresql+psycopg://face_voice_rec:change-this-password@localhost:5432

uv pip install flashinfer-jit-cache \
  --index-url https://flashinfer.ai/whl/cu130
  
  
  
export CUTE_DSL_ARCH=sm_121a

vllm serve unsloth/Qwen3.6-35B-A3B-NVFP4 \
    --moe-backend flashinfer_b12x \
    --max-model-len 8192 \
    --gpu-memory-utilization 0.80
    
    
vllm --version
python -c "import torch; print('PyTorch:',torch.__version__); print('CUDA:',torch.version.cuda); print('GPU:',torch.cuda.get_device_name(0))"

