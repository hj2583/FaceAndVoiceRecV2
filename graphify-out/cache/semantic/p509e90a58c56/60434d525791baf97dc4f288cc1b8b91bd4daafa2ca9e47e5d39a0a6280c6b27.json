{"nodes": [{"id": "docs_superpowers_specs_2026_10_05_face_recognition_attendance_design", "label": "Face-Recognition Attendance Design Spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-10-05-face-recognition-attendance-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Design spec adding an attendance list on top of existing realtime and uploaded-video face recognition, because existing recognition logs are sampling/debug records unsuitable as attendance rows without event-level filtering and stable source identity.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_05_face_recognition_attendance_design_attendance_events", "label": "attendance_events Table", "file_type": "code", "source_file": "docs/superpowers/specs/2026-10-05-face-recognition-attendance-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New table storing one row per attendance event, kept separate from recognition_logs and audio_logs which remain for diagnostic purposes; uniqueness on (source, source_ref, track_id, person_id) makes repeated observations idempotent within a source run.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_05_face_recognition_attendance_design_attendance_event", "label": "Attendance Event Semantics", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-05-face-recognition-attendance-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An appearance is identified by the tuple (source, source_ref, track_id, person_id); only observations with person_id set and confidence >= RECOGNITION_THRESHOLD are eligible, and the first eligible observation per track creates the event while repeated observations do not.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_05_face_recognition_attendance_design_persons", "label": "persons Table", "file_type": "code", "source_file": "docs/superpowers/specs/2026-10-05-face-recognition-attendance-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "metadata": {"graphify_reference_stub": true}, "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_05_face_recognition_attendance_design_recognition_logs", "label": "recognition_logs Table", "file_type": "code", "source_file": "docs/superpowers/specs/2026-10-05-face-recognition-attendance-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Existing sampling/debug records (repeated realtime samples, per-frame video records) that are unsuitable as attendance rows and must remain available for diagnostics.", "metadata": {"graphify_reference_stub": true}, "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_05_face_recognition_attendance_design_audio_logs", "label": "audio_logs Table", "file_type": "code", "source_file": "docs/superpowers/specs/2026-10-05-face-recognition-attendance-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Existing audio logs kept available for their current diagnostic purposes, stored separately from attendance.", "metadata": {"graphify_reference_stub": true}, "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_05_face_recognition_attendance_design_recognition_threshold", "label": "config.RECOGNITION_THRESHOLD", "file_type": "code", "source_file": "docs/superpowers/specs/2026-10-05-face-recognition-attendance-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Existing threshold (currently 0.70) reused for attendance eligibility; unknown or below-threshold faces are not recorded, and eligibility is fixed at capture time so later threshold changes do not hide historical rows.", "metadata": {"graphify_reference_stub": true}, "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_05_face_recognition_attendance_design_init_db", "label": "init_db() Migration", "file_type": "code", "source_file": "docs/superpowers/specs/2026-10-05-face-recognition-attendance-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Existing idempotent migration pattern through which the attendance_events table is added.", "metadata": {"graphify_reference_stub": true}, "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_05_face_recognition_attendance_design_attendance_tab", "label": "Attendance Streamlit Tab", "file_type": "code", "source_file": "docs/superpowers/specs/2026-10-05-face-recognition-attendance-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New tab in existing Streamlit navigation with a Realtime/Uploaded-video source selector; realtime defaults to last 24 hours with an 'Up to now' end boundary that advances on rerun, defaults seeded once per session, and video mode requires one normalized-path video selection.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_05_face_recognition_attendance_design_realtime_workflow", "label": "Realtime Attendance Workflow", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-05-face-recognition-attendance-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generates a fresh run ID when a camera recognition process starts and records eligible tracks once during that run; timestamps are stored as UTC ISO-8601 converted from the pipeline's monotonic clock rather than raw monotonic values.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_05_face_recognition_attendance_design_video_workflow", "label": "Uploaded-Video Attendance Workflow", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-05-face-recognition-attendance-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Collects the first eligible recognition per track while processing and stores the clip offset in milliseconds with a null calendar timestamp (no invented recording date); rows for a normalized video path are replaced transactionally only after a successful run, preserving prior rows on failure.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_05_face_recognition_attendance_design_track_id", "label": "track_id (run-local track identifier)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-05-face-recognition-attendance-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local to a run/video and separates distinct tracked appearances; a tracker losing and reacquiring a person as a new track is treated as a new appearance.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_05_face_recognition_attendance_design_person_id", "label": "person_id (persistent person identifier)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-05-face-recognition-attendance-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Persistent identifier linking to a known person in the database, deliberately kept distinct from the run-local track_id.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_05_face_recognition_attendance_design_source_ref", "label": "source_ref (run ID or normalized video path)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-05-face-recognition-attendance-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stable source identity: a generated realtime run ID or a normalized absolute uploaded-video path; moving or renaming a video creates a different source reference.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_05_face_recognition_attendance_design_csv_export", "label": "Attendance CSV Export", "file_type": "code", "source_file": "docs/superpowers/specs/2026-10-05-face-recognition-attendance-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exports exactly the selected source, time interval, and person rows; spreadsheet CSV exports are protected by escaping formula-leading text cells, and video clip offsets are never presented as dates.", "_origin": "semantic"}], "edges": [{"source": "docs_superpowers_specs_2026_10_05_face_recognition_attendance_design", "target": "docs_superpowers_specs_2026_10_05_face_recognition_attendance_design_attendance_events", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-05-face-recognition-attendance-design.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "docs_superpowers_specs_2026_10_05_face_recognition_attendance_design", "target": "docs_superpowers_specs_2026_10_05_face_recognition_attendance_design_attendance_event", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-05-face-recognition-attendance-design.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "docs_superpowers_specs_2026_10_05_face_recognition_attendance_design", "target": "docs_superpowers_specs_2026_10_05_face_recognition_attendance_design_attendance_tab", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpow