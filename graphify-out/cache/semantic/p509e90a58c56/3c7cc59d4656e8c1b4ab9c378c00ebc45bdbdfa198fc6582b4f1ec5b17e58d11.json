{"nodes": [{"id": "readme", "label": "FaceAndVoiceRecV2 README", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Documents the multi-model architecture combining face recognition, voice embeddings, transcription, and active-speaker estimation. Describes production storage migration to PostgreSQL + Qdrant, optional LLM transcript refinement, and deployment procedures.", "_origin": "semantic"}, {"id": "face_and_voice_rec_v2", "label": "FaceAndVoiceRecV2 Application", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Streamlit application combining multiple models: UniFace for face detection/recognition/landmarks, Silero VAD for speech detection, Whisper for transcription, SpeechBrain ECAPA-TDNN for voice embeddings. No single model handles all tasks; active-speaker estimation combines VAD timing with FaceMesh lip motion.", "_origin": "semantic"}, {"id": "postgresql", "label": "PostgreSQL", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Authoritative relational store for person IDs, enrollment quality, attendance, transcripts, and log records. Required for application runtime. SQLite retained only as legacy import source and for isolated tests. Alembic manages schema migrations.", "_origin": "semantic"}, {"id": "qdrant", "label": "Qdrant Vector Store", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stores face and voice embeddings for vector search. Payloads contain vector metadata and object references, not media files. Collections initialized from environment settings. Local .npy embeddings retained for recovery and backfill.", "_origin": "semantic"}, {"id": "silero_vad", "label": "Silero VAD", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Speech activity detection model. Finds speech regions in audio but does not generate transcript text. Used for VAD timing in active-speaker estimation and for sampling speech regions in multilingual transcription.", "_origin": "semantic"}, {"id": "openai_whisper", "label": "OpenAI Whisper", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transcription model (small variant). Converts extracted audio into text and timestamps. Uses transcribe mode to retain spoken language. Does not identify speakers. FFmpeg extracts audio from uploaded video.", "_origin": "semantic"}, {"id": "speechbrain_ecapa_tdnn", "label": "SpeechBrain ECAPA-TDNN", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Voice embedding model for speaker clustering and matching. Voice identity matching compares ECAPA cosine similarity with quality-filtered enrollment samples, requiring threshold 0.50, ambiguity margin 0.05, and minimum 3-second cluster duration.", "_origin": "semantic"}, {"id": "streamlit", "label": "Streamlit", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Web UI framework for the application. Entry point at app/main.py. Host-run app at localhost:8501, Docker app at localhost:8502.", "_origin": "semantic"}, {"id": "uniface_scrfd", "label": "UniFace SCRFD", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Face detection model. Larger model used for uploaded videos, lighter model for realtime. Detects face locations in video frames.", "_origin": "semantic"}, {"id": "uniface_arcface", "label": "UniFace ArcFace", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Face recognition model. Converts a face into a 512-dimensional embedding and compares with enrolled face embeddings using cosine similarity and a confidence threshold.", "_origin": "semantic"}, {"id": "uniface_facemesh", "label": "UniFace FaceMesh", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Facial landmark model. Locates facial features including the mouth to measure mouth opening and motion for active-speaker estimation.", "_origin": "semantic"}, {"id": "ffmpeg", "label": "FFmpeg", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Audio/video processing tool. Extracts audio from uploaded video for Whisper transcription. Taken from PATH when available; otherwise imageio-ffmpeg dependency supplies a bundled executable.", "_origin": "semantic"}, {"id": "ollama", "label": "Ollama", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional local LLM service for transcript refinement. Disabled by default. Formats and groups existing transcript fragments while preserving spoken words and speaker labels. Does not replace Whisper or determine speaker identities. Default URL uses unencrypted HTTP.", "_origin": "semantic"}, {"id": "scripts_backfill_qdrant_embeddings", "label": "Qdrant Backfill Script", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Report-first script that migrates existing known and unresolved face/voice vectors to Qdrant with deterministic IDs. Run from repository root, review report, then pass --apply. Safely upserts on re-run. Does not migrate relational records or media files.", "metadata": {"graphify_reference_stub": true}, "_origin": "semantic"}, {"id": "scripts_migrate_sqlite_to_postgres", "label": "SQLite to PostgreSQL Migration Script", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Report-first importer that copies relational rows from legacy SQLite to PostgreSQL. Creates the schema and refuses to write into a non-empty target. Copies relational rows, not media files. Run report first, then --apply.", "metadata": {"graphify_reference_stub": true}, "_origin": "semantic"}, {"id": "app_main", "label": "Streamlit App Entry Point", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Main Streamlit application entry point. Launched with 'streamlit run app/main.py' from repository root or 'streamlit run main.py' from app/ directory.", "metadata": {"graphify_reference_stub": true}, "_origin": "semantic"}, {"id": "docker_compose", "label": "Docker Compose Configuration", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs app, PostgreSQL, and Qdrant in separate Linux containers. Reuses existing face_voice_postgres and face_voice_qdrant volumes. Uses NVIDIA/CUDA requirements. Entrypoint changes DB hostname to 'postgres'. Windows webcam/mic not passed through to Linux container.", "metadata": {"graphify_reference_stub": true}, "_origin": "semantic"}], "edges": [{"source": "readme", "target": "face_and_voice_rec_v2", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "readme", "target": "postgresql", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "readme", "target": "qdrant", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "readme", "target": "silero_vad", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "readme", "target": "openai_whisper", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "readme", "target": "speechbrain_ecapa_tdnn", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "readme", "target": "streamlit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "readme", "target": "uniface_scrfd", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "readme", "target": "uniface_arcface", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "so