{"nodes": [{"id": "docs_superpowers_specs_2026_10_13_lazy_load_and_db_lock_design", "label": "Lazy Loading and DB Lock Design Doc", "file_type": "document", "source_file": "docs/superpowers/specs/2026-10-13-lazy-load-and-db-lock-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_13_lazy_load_and_db_lock_design_app_main", "label": "app/main.py", "file_type": "code", "source_file": "docs/superpowers/specs/2026-10-13-lazy-load-and-db-lock-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Currently imports all seven page modules at module load and invokes every page renderer under st.tabs on each rerun; will be refactored to lazy-load only the selected tab's module.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_13_lazy_load_and_db_lock_design_get_runtime_status", "label": "get_runtime_status()", "file_type": "code", "source_file": "docs/superpowers/specs/2026-10-13-lazy-load-and-db-lock-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Imports Torch when called; currently invoked before tab rendering on every rerun; will become an explicit Check runtime action storing result in st.session_state.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_13_lazy_load_and_db_lock_design_init_db", "label": "init_db()", "file_type": "code", "source_file": "docs/superpowers/specs/2026-10-13-lazy-load-and-db-lock-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Performs DDL and compatibility backfills including UPDATE transcription_segments SET original_text=text WHERE original_text IS NULL; will hold _DB_LOCK, use 30s timeout, WAL mode, and BEGIN IMMEDIATE to serialize competing processes and prevent partial schema updates.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_13_lazy_load_and_db_lock_design_db_lock", "label": "_DB_LOCK", "file_type": "code", "source_file": "docs/superpowers/specs/2026-10-13-lazy-load-and-db-lock-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Existing process lock that currently protects get_conn() only; will be held across init_db() initialization to serialize with get_conn() in the same process.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_13_lazy_load_and_db_lock_design_st_tabs", "label": "st.tabs (Stateful Tabs API)", "file_type": "code", "source_file": "docs/superpowers/specs/2026-10-13-lazy-load-and-db-lock-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Streamlit 1.64.0 exposes on_change='rerun' and .open property; used to import/render only the active and previously visited pages, with eager fallback for older versions.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_13_lazy_load_and_db_lock_design_transcription_segments", "label": "transcription_segments Table", "file_type": "code", "source_file": "docs/superpowers/specs/2026-10-13-lazy-load-and-db-lock-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SQLite table subject to compatibility backfill: UPDATE transcription_segments SET original_text=text WHERE original_text IS NULL.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_13_lazy_load_and_db_lock_design_word_timestamps", "label": "word_timestamps Table", "file_type": "code", "source_file": "docs/superpowers/specs/2026-10-13-lazy-load-and-db-lock-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SQLite table whose duplicate-column errors were observed in the concurrency reproduction (3 duplicate word_timestamps errors across 200 init_db() calls).", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_13_lazy_load_and_db_lock_design_face_index", "label": "FaceIndex", "file_type": "code", "source_file": "docs/superpowers/specs/2026-10-13-lazy-load-and-db-lock-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stays behind its existing cached getter and is reached only when the Face Database tab is selected, deferring model creation.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_13_lazy_load_and_db_lock_design_wal_mode", "label": "WAL Mode", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-13-lazy-load-and-db-lock-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Set before beginning the schema transaction to let SQLite serialize competing app/realtime processes.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_13_lazy_load_and_db_lock_design_legacy_migration", "label": "Legacy File/Path Migration", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-13-lazy-load-and-db-lock-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Serialized across processes with a persistent SQLite lock database under the target data/ root; preflight walks every source descendant, rejects symlinks, checks same-filesystem constraints, and rejects conflicts before any move.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_13_lazy_load_and_db_lock_design_requirements_txt", "label": "requirements.txt", "file_type": "code", "source_file": "docs/superpowers/specs/2026-10-13-lazy-load-and-db-lock-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Supports Streamlit 1.40+, so an eager compatibility fallback is required for versions without the stateful tabs API.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_13_lazy_load_and_db_lock_design_streamlit", "label": "Streamlit", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-13-lazy-load-and-db-lock-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_13_lazy_load_and_db_lock_design_torch", "label": "Torch", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-13-lazy-load-and-db-lock-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Imported by get_runtime_status() when called; deferred until the Check runtime action is activated.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_13_lazy_load_and_db_lock_design_onnx", "label": "ONNX", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-13-lazy-load-and-db-lock-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runtime probe deferred until the Check runtime action is activated.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_13_lazy_load_and_db_lock_design_realtime_worker", "label": "Realtime Worker Process", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-13-lazy-load-and-db-lock-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separate process that calls init_db() once at worker startup; remains independent of the Streamlit process's cached initialization.", "_origin": "semantic"}, {"id": "docs_superpowers_specs_2026_10_13_lazy_load_and_db_lock_design_show_sidebar_navigation", "label": "client.showSidebarNavigation", "file_type": "code", "source_file": "docs/superpowers/specs/2026-10-13-lazy-load-and-db-lock-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Streamlit scriptable option set to False before constructing navigation to prevent the conventional app/pages/ directory from creating duplicate sidebar links.", "_origin": "semantic"}], "edges": [{"source": "docs_superpowers_specs_2026_10_13_lazy_load_and_db_lock_design_app_main", "target": "docs_superpowers_specs_2026_10_13_lazy_load_and_db_lock_design_st_tabs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-13-lazy-load-and-db-lock-design.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "docs_superpowers_specs_2026_10_13_lazy_load_and_db_lock_design_app_main", "target": "docs_superpowers_specs_2026_10_13_lazy_load_and_db_lock_design_get_runtime_status", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-13-lazy-load-and-db-lock-design.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "docs_superpowers_specs_2026_10_13_lazy_load_and_db_lock_design_app_main", "target": "docs_superpowers_specs_2026_10_13_lazy_load_and_db_lock_design_init_db", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-13-lazy-load-and-db-lock-design.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "docs_superpowers_specs_2026_10_13_lazy_load_and_db_lock_design_app_main", "target": "docs_superpowers_specs_2026_10_13_lazy_load_and_db_lock_design_face_index", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-13-lazy-load-and-db-lock-design